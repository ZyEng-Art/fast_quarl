+std::vector<size_t> Graph::xfer_binding(GraphXfer *xfer, Op op) const {
+  std::deque<std::pair<OpX *, Op>> matched;
+  std::vector<size_t> guids;
+  if (!_pattern_matching(xfer, op, matched))
+    return guids;
+  if (_loop_check_after_matching(xfer)) {
+    for (const auto *opx : xfer->srcOps)
+      if (opx->mapOp.ptr->is_quantum_gate())
+        guids.push_back(opx->mapOp.guid);
+  }
+  while (!matched.empty()) {
+    auto pair = matched.back();
+    matched.pop_back();
+    xfer->unmatch(pair.first, pair.second, this);
+  }
+  return guids;
+}
